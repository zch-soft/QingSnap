<Window x:Class="QingSnap.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        Title="从系统卸载 QingSnap"
        Icon="pack://application:,,,/QingSnap;component/Assets/QingSnap.ico"
        Width="580"
        SizeToContent="Height"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF091017"
        Foreground="#FFF3F7F9"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="UninstallPanel" Color="#FF101B23" />
        <SolidColorBrush x:Key="UninstallLine" Color="#4D59707C" />
        <SolidColorBrush x:Key="UninstallAccent" Color="#FF76DFEE" />
        <SolidColorBrush x:Key="UninstallMuted" Color="#FF8FA2AD" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE3EDF0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="#FFDDE8EC" />
            <Setter Property="Background" Value="#FF172630" />
            <Setter Property="BorderBrush" Value="#FF365563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FF223641" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF304F5C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF0C151D"
                    BorderBrush="{StaticResource UninstallLine}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <StackPanel Margin="16,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#FF132A35" CornerRadius="7">
                            <icons:QingSnapIcon Kind="Text" Width="16" Height="16" Foreground="{StaticResource UninstallAccent}" />
                        </Border>
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="从系统卸载 QingSnap" />
                    </StackPanel>
                    <Button Width="44"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF91A6B0"
                            Cursor="Hand"
                            Click="OnCancelClick">
                        <icons:QingSnapIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,14,20,14">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="将移除开始菜单快捷方式、开机启动项，以及“应用和功能”中的卸载登记。" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="10.5"
                               Foreground="{StaticResource UninstallMuted}"
                               TextWrapping="Wrap"
                               Text="程序文件夹不会被自动删除，卸载完成后会提示它的位置。用户数据默认全部保留，可按需勾选删除。" />

                    <Border Margin="0,14,0,0"
                            Padding="12,9"
                            Background="#22FF4E5B"
                            BorderBrush="#55FF4E5B"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock FontSize="10.5"
                                   Foreground="#FFFFB4AE"
                                   TextWrapping="Wrap"
                                   Text="勾选的数据删除后不可恢复。程序文件始终保留。" />
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="12,9"
                            Background="{StaticResource UninstallPanel}"
                            BorderBrush="{StaticResource UninstallLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="HistoryCheck" Content="截图" />
                            <TextBlock x:Name="HistoryPathText"
                                       Margin="22,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource UninstallMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0"
                            Padding="12,9"
                            Background="{StaticResource UninstallPanel}"
                            BorderBrush="{StaticResource UninstallLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="DatabaseCheck" Content="数据库" />
                            <TextBlock x:Name="DatabasePathText"
                                       Margin="22,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource UninstallMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0"
                            Padding="12,9"
                            Background="{StaticResource UninstallPanel}"
                            BorderBrush="{StaticResource UninstallLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="SettingsCheck" Content="设置" />
                            <TextBlock x:Name="SettingsPathText"
                                       Margin="22,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource UninstallMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0"
                            Padding="12,9"
                            Background="{StaticResource UninstallPanel}"
                            BorderBrush="{StaticResource UninstallLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="OcrCheck" Content="OCR 模型" />
                            <TextBlock x:Name="OcrPathText"
                                       Margin="22,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource UninstallMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0"
                            Padding="12,9"
                            Background="{StaticResource UninstallPanel}"
                            BorderBrush="{StaticResource UninstallLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="LogsCheck" Content="日志与临时文件" />
                            <TextBlock x:Name="LogsPathText"
                                       Margin="22,4,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource UninstallMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FF0D171F"
                    BorderBrush="{StaticResource UninstallLine}"
                    BorderThickness="0,1,0,0">
                <StackPanel Margin="0,0,18,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" Content="取消" Click="OnCancelClick" />
                    <Button Style="{StaticResource DialogButton}"
                            Background="#FF4E5B"
                            BorderBrush="#FF8A343C"
                            Foreground="#FF071116"
                            Content="卸载"
                            Click="OnUninstallClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
