<Window x:Class="QingSnap.App.Views.SelectionPresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命名选区管理"
        Width="780"
        Height="540"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B151C"
        Foreground="#FFEAF2F5"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFEAF2F5" />
            <Setter Property="Background" Value="#FF16242E" />
            <Setter Property="BorderBrush" Value="#5576DFEE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF1E3340" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFEAF2F5" />
            <Setter Property="Background" Value="#FF0E1A22" />
            <Setter Property="BorderBrush" Value="#44536A76" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CaretBrush" Value="#FF76DFEE" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="命名选区" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="#FF8FA3AD"
                       TextWrapping="Wrap"
                       Text="保存的选区可从托盘菜单直接开始截图，不受最近 5 条限制。修改名称后按 Enter 或点击其他位置即可保存。" />
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PresetPanel" />
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#FF76DFEE"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    x:Name="CreateFromLastButton"
                    Content="从上次选区新建"
                    Click="OnCreateFromLastClick" />
            <Button Grid.Column="2" Content="关闭" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
